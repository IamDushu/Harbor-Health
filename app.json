{
  "expo": {
    "name": "Harbor-Health",
    "slug": "Harbor-Health",
    "version": "1.0.0",
    "scheme": "harbor-health",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dushu.Harbor-Health"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GT-Super-Display-Bold-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Display-Bold-Trial.otf",
            "./assets/fonts/GT-Super-Display-Light-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Display-Light-Trial.otf",
            "./assets/fonts/GT-Super-Display-Medium-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Display-Medium-Trial.otf",
            "./assets/fonts/GT-Super-Display-Regular-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Display-Regular-Trial.otf",
            "./assets/fonts/GT-Super-Display-Super-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Display-Super-Trial.otf",
            "./assets/fonts/GT-Super-Text-Black-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Text-Black-Trial.otf",
            "./assets/fonts/GT-Super-Text-Bold-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Text-Bold-Trial.otf",
            "./assets/fonts/GT-Super-Text-Book-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Text-Book-Trial.otf",
            "./assets/fonts/GT-Super-Text-Medium-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Text-Medium-Trial.otf",
            "./assets/fonts/GT-Super-Text-Regular-Italic-Trial.otf",
            "./assets/fonts/GT-Super-Text-Regular-Trial.otf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "$(PRODUCT_NAME) would like to use your camera to share image in a message."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) would like to use your device gallery to attach image in a message."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "$(PRODUCT_NAME) would like access to your photo gallery to share image in a message.",
          "savePhotosPermission": "$(PRODUCT_NAME) would like to save photos to your photo gallery after downloading from a message."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "$(PRODUCT_NAME) would like to use your microphone for voice recording."
        }
      ]
    ]
  }
}
